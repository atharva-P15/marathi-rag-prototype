# =============================================================
# Marathi RAG Prototype — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================

# --- Groq API ---
GROQ_API_KEY=your_groq_api_key_here

# --- LLM Settings ---
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=2048
GROQ_TEMPERATURE=0.1          # Low temp = grounded, factual answers

# --- Whisper Settings ---
# Options: tiny, base, small, medium, large-v2, large-v3
# Use 'medium' for CPU. Use 'large-v3' for best Marathi accuracy (GPU recommended).
WHISPER_MODEL=medium

# --- Embedding Settings ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu            # Use 'cuda' if GPU available

# --- ChromaDB Settings ---
CHROMA_PERSIST_DIR=./database/chroma
CHROMA_COLLECTION_NAME=marathi_chunks

# --- SQLite Settings ---
SQLITE_DB_PATH=./database/sqlite/metadata.db

# --- Media Paths ---
MEDIA_VIDEOS_DIR=./media/videos
MEDIA_AUDIO_DIR=./media/audio
MEDIA_TRANSCRIPTS_DIR=./media/transcripts
MEDIA_CHUNKS_DIR=./media/chunks

# --- Retrieval Settings ---
TOP_K_CHUNKS=5                  # Final chunks after reranking
RETRIEVAL_CANDIDATES=20         # Initial candidates for hybrid search
ENABLE_RERANKING=true           # Cross-encoder reranking (bge-reranker-v2-m3)
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
ENABLE_QUERY_EXPANSION=true     # Expand queries with Marathi keywords
ENABLE_CONTEXTUAL_COMPRESSION=true  # Extract relevant sentences from chunks

# --- Backend Settings ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Chunking Settings ---
CHUNK_WORD_LIMIT=200            # Target words per chunk
CHUNK_OVERLAP_WORDS=40          # Word overlap between adjacent chunks
CHUNK_MIN_WORDS=30              # Minimum words per chunk
CHUNK_OVERLAP_SEGMENTS=1        # Legacy — superseded by CHUNK_OVERLAP_WORDS
